import re

try:
    import oracledb
    oracledb_exists = True
except ImportError:
    oracledb_exists = False


def check_parameter_exists(module, mode, msg, cursor, name):
    if not name:
        module.fail_json(msg='Error: Missing parameter name', changed=False)
        return False

    if name.startswith('_') and mode != 'sysdba':
        module.fail_json(msg='SYSDBA privilege is required to verify underscore parameter (%s)' % name, changed=False)
        return False
    elif name.startswith('_') and mode == 'sysdba':
        sql = "select lower(ksppinm) from sys.x$ksppi where ksppinm = lower('%s')" % name
    else:
        sql = "select lower(name) from v$parameter where name = lower('%s')" % name

    try:
        cursor.execute(sql)
        result = cursor.fetchone()
    except oracledb.DatabaseError as exc:
        module.fail_json(msg='Error checking parameter existence: %s (sql: %s)' % (str(exc), sql), changed=False)
        return False

    if result:
        return True
    else:
        module.fail_json(msg="The parameter '%s' does not exist in the database." % name, changed=False)
        return False


def modify_parameter(module, mode, msg, cursor, name, value, comment, scope, sid):
    contains = re.compile(r'[?*$%#()!\s,._/=+-]')
    starters = ('+', '_', '"', '"_', '/')

    if not name:
        module.fail_json(msg='Error: Missing parameter name.', changed=False)
        return False

    val_str = '' if value is None else str(value).strip()
    currval = get_curr_value(module, mode, msg, cursor, name, scope)

    # Check if value is already set
    if (currval.lower() == val_str.lower()) or (not currval and val_str in ('', "''", '""')):
        clean_nm = clean_string(name)
        display_val = "''" if val_str in ('', "''", '""') else val_str
        module.exit_json(msg="The parameter (%s) is already set to %s" % (clean_nm, display_val), changed=False)
        return True

    if module.check_mode:
        display_val = "''" if val_str in ('', "''", '""') else val_str
        msg_txt = "%s will be changed, new: %s, old: %s" % (name, display_val, currval.upper() if currval else "''")
        module.exit_json(msg=msg_txt, changed=True)

    formatted_name = quote_name(name) if name.startswith(starters) else name

    # If setting to null/empty string, Oracle SQL requires ''
    if val_str in ('', "''", '""'):
        formatted_val = "''"
    elif contains.search(val_str):
        formatted_val = quote_value(val_str)
    else:
        formatted_val = val_str

    sql = "alter system set %s=%s" % (formatted_name, formatted_val)
    if comment is not None:
        sql += " comment='%s'" % comment
    sql += " scope=%s sid='%s'" % (scope, sid)

    try:
        cursor.execute(sql)
    except oracledb.DatabaseError as exc:
        module.fail_json(msg='Error modifying parameter (%s): %s (sql: %s)' % (name, str(exc), sql), changed=False)

    clean_nm = clean_string(name)
    display_val = "''" if val_str in ('', "''", '""') else val_str
    old_display = "''" if not currval else currval
    msg_txt = "The parameter (%s) has been changed successfully, new: %s, old: %s" % (clean_nm, display_val, old_display)
    module.exit_json(msg=msg_txt, changed=True)
    return True


def quote_value(value):
    if len(value) > 0 and not (value.startswith("'") and value.endswith("'")):
        return "'%s'" % value
    return value


def quote_name(name):
    if len(name) > 0 and not (name.startswith('"') and name.endswith('"')):
        return '"%s"' % name
    return name


def clean_string(item):
    return item.replace('"', '')


def reset_parameter(module, mode, msg, cursor, name, value, comment, scope, sid):
    starters = ('+', '_', '"', '"_')
    if not name:
        module.fail_json(msg='Error: Missing parameter name', changed=False)
        return False

    if module.check_mode:
        module.exit_json(changed=True)

    formatted_name = quote_name(name) if name.startswith(starters) else name
    sql = "alter system reset %s scope=%s sid='%s'" % (formatted_name, scope, sid)

    try:
        cursor.execute(sql)
    except oracledb.DatabaseError as exc:
        error, = exc.args
        if hasattr(error, 'code') and error.code == 32010:
            clean_nm = clean_string(name)
            module.exit_json(msg="The parameter (%s) is already set to its default value" % clean_nm, changed=False)
            return True
        module.fail_json(msg='Error resetting parameter (%s): %s (sql: %s)' % (name, str(exc), sql), changed=False)

    clean_nm = clean_string(name)
    module.exit_json(msg="The parameter (%s) has been reset to its default value" % clean_nm, changed=True)
    return True


def get_curr_value(module, mode, msg, cursor, name, scope):
    clean_nm = clean_string(name)

    if scope == 'spfile':
        parameter_source = 'v$spparameter'
    else:
        parameter_source = 'v$parameter'

    if mode == 'sysdba':
        if scope == 'spfile':
            sql = "select lower(KSPSPFFTCTXSPDVALUE) from sys.x$kspspfile where lower(KSPSPFFTCTXSPNAME) = lower('%s')" % clean_nm
        else:
            sql = "select lower(y.ksppstdvl) from sys.x$ksppi x, sys.x$ksppcv y where x.indx = y.indx and x.ksppinm = lower('%s')" % clean_nm
    else:
        sql = "select lower(display_value) from %s where name = lower('%s')" % (parameter_source, clean_nm)

    try:
        cursor.execute(sql)
        rows = cursor.fetchall()
        if rows and rows[0] and rows[0][0] is not None:
            return str(rows[0][0])
        # Fallback query
        cursor.execute("select lower(display_value) from v$parameter where name = lower('%s')" % clean_nm)
        rows = cursor.fetchall()
        if rows and rows[0] and rows[0][0] is not None:
            return str(rows[0][0])
        return ''
    except oracledb.DatabaseError as exc:
        module.fail_json(msg='Error retrieving current value for %s: %s (sql: %s)' % (clean_nm, str(exc), sql), changed=False)

    return ''


from ansible.module_utils.basic import AnsibleModule


def main():
    module = AnsibleModule(
        argument_spec = dict(
            hostname      = dict(default='localhost'),
            port          = dict(default=1521, type='int'),
            service_name  = dict(required=True),
            user          = dict(required=False),
            password      = dict(required=False, no_log=True),
            mode          = dict(default='normal', choices=["normal", "sysdba"]),
            name          = dict(required=True, aliases=['parameter']),
            value         = dict(default=None),
            comment       = dict(default=None),
            state         = dict(default="present", choices=["present", "absent", "reset"]),
            scope         = dict(default="both", choices=["both", "spfile", "memory"]),
            sid           = dict(default="*"),
        ),
        supports_check_mode=True
    )

    if not oracledb_exists:
        module.fail_json(msg="The python-oracledb module is required on the Ansible control node. Install with: pip install oracledb")

    hostname = module.params["hostname"]
    port = module.params["port"]
    service_name = module.params["service_name"]
    user = module.params["user"]
    password = module.params["password"]
    mode = module.params["mode"]
    name = module.params["name"]
    value = module.params["value"]
    comment = module.params["comment"]
    state = module.params["state"]
    scope = module.params["scope"]
    sid = module.params["sid"]

    wallet_connect = '/@%s' % service_name
    try:
        if not user and not password:
            if mode == 'sysdba':
                conn = oracledb.connect(dsn=wallet_connect, mode=oracledb.SYSDBA)
            else:
                conn = oracledb.connect(dsn=wallet_connect)
        elif user and password:
            dsn = f"{hostname}:{port}/{service_name}"
            if mode == 'sysdba':
                conn = oracledb.connect(user=user, password=password, dsn=dsn, mode=oracledb.SYSDBA)
            else:
                conn = oracledb.connect(user=user, password=password, dsn=dsn)
        else:
            module.fail_json(msg='Missing username or password for database connection')
    except oracledb.DatabaseError as exc:
        module.fail_json(msg='Could not connect to database (%s:%s/%s) - %s' % (hostname, port, service_name, str(exc)), changed=False)

    cursor = conn.cursor()
    msg = ['']

    if state == 'present':
        if check_parameter_exists(module, mode, msg, cursor, name):
            modify_parameter(module, mode, msg, cursor, name, value, comment, scope, sid)
    elif state in ('reset', 'absent'):
        if check_parameter_exists(module, mode, msg, cursor, name):
            reset_parameter(module, mode, msg, cursor, name, value, comment, scope, sid)


if __name__ == '__main__':
    main()
