except ImportError:
    oracledb_exists = False
else:
    oracledb_exists = True

import xml.etree.ElementTree as ET
from ansible.module_utils.basic import AnsibleModule

def rows_to_dict_list(cursor):
    if not cursor.description:
        return []
    columns = [col[0].lower() for col in cursor.description]
    results = []
    for row in cursor.fetchall():
        row_dict = {}
        for col, val in zip(columns, row):
            if hasattr(val, 'read'):
                val = val.read()
            row_dict[col] = val
        results.append(row_dict)
    return results

def safe_query(conn, query):
    try:
        cur = conn.cursor()
        cur.execute(query)
        res = rows_to_dict_list(cur)
        cur.close()
        return res
    except Exception:
        return []

def get_opatch_patches(conn):
    patches = []
    # 1. Try querying sys.dbms_qopatch.get_opatch_lsinventory()
    try:
        cur = conn.cursor()
        cur.execute("SELECT sys.dbms_qopatch.get_opatch_lsinventory() FROM dual")
        row = cur.fetchone()
        if row and row[0]:
            clob_val = row[0]
            xml_str = clob_val.read() if hasattr(clob_val, 'read') else str(clob_val)
            if xml_str and '<patch' in xml_str.lower():
                root = ET.fromstring(xml_str)
                for p in root.iter():
                    tag = p.tag.split('}')[-1].lower() if '}' in p.tag else p.tag.lower()
                    if tag == 'patch' or tag.endswith('_patch') or tag == 'oneoff':
                        p_id = ''
                        p_desc = ''
                        p_date = ''
                        for child in p:
                            ctag = child.tag.split('}')[-1].lower() if '}' in child.tag else child.tag.lower()
                            if ctag in ('patchid', 'id', 'bug'):
                                p_id = child.text or ''
                            elif 'description' in ctag or 'desc' in ctag:
                                p_desc = child.text or ''
                            elif 'installedon' in ctag or 'applieddate' in ctag or 'date' in ctag or 'time' in ctag:
                                p_date = child.text or ''
                        if not p_id and 'id' in p.attrib:
                            p_id = p.attrib['id']
                        if not p_desc and 'description' in p.attrib:
                            p_desc = p.attrib['description']
                        if p_id:
                            entry = {
                                'patch_id': p_id.strip(),
                                'description': p_desc.strip(),
                                'installed_on': p_date.strip()
                            }
                            if entry not in patches:
                                patches.append(entry)
        cur.close()
    except Exception:
        pass

    # 2. Try XMLTABLE query on dbms_qopatch if ElementTree got nothing
    if not patches:
        xmltable_query = """
        SELECT
            x.patch_id,
            x.patch_description AS description,
            x.installed_on
        FROM XMLTABLE(
            '//patch'
            PASSING XMLTYPE(sys.dbms_qopatch.get_opatch_lsinventory())
            COLUMNS
                patch_id VARCHAR2(30) PATH 'patchID | @id | bug',
                patch_description VARCHAR2(300) PATH 'patchDescription | description | desc',
                installed_on VARCHAR2(50) PATH 'installedOn | appliedDate | date'
        ) x
        WHERE x.patch_id IS NOT NULL
        """
        patches = safe_query(conn, xmltable_query)

    # 3. Fallback to dba_registry_sqlpatch
    if not patches:
        sqlpatch_query = """
        SELECT patch_id, patch_uid, version, action, status, description,
               to_char(action_time, 'YYYY-MM-DD HH24:MI:SS') AS action_time
        FROM dba_registry_sqlpatch
        ORDER BY action_time DESC
        """
        patches = safe_query(conn, sqlpatch_query)

    # 4. Fallback to dba_registry
    if not patches:
        registry_query = """
        SELECT comp_id, comp_name, version, status, modified
        FROM dba_registry
        ORDER BY comp_name
        """
        patches = safe_query(conn, registry_query)

    return patches

def main():
    module = AnsibleModule(
        argument_spec = dict(
            hostname      = dict(default='localhost'),
            port          = dict(default=1521, type='int'),
            service_name  = dict(required=True),
            user          = dict(default='sys', required=False),
            password      = dict(required=False, no_log=True),
            mode          = dict(default='sysdba', choices=["normal", "sysdba"]),
        ),
        supports_check_mode=True
    )

    if not oracledb_exists:
        module.fail_json(msg="The oracledb module is required. 'pip install oracledb' should do the trick. Thin mode is used by default and requires no Oracle client installation.")

    hostname = module.params["hostname"]
    port = module.params["port"]
    service_name = module.params["service_name"]
    user = module.params["user"]
    password = module.params["password"]
    mode = module.params["mode"]

    wallet_connect = '/@%s' % service_name
    try:
        if not user and not password:
            if mode == 'sysdba':
                conn = oracledb.connect(dsn=wallet_connect, mode=oracledb.SYSDBA)
            else:
                conn = oracledb.connect(dsn=wallet_connect)
        elif user and password:
            dsn = oracledb.makedsn(host=hostname, port=port, service_name=service_name)
            if mode == 'sysdba':
                conn = oracledb.connect(user=user, password=password, dsn=dsn, mode=oracledb.SYSDBA)
            else:
                conn = oracledb.connect(user=user, password=password, dsn=dsn)
        else:
            module.fail_json(msg='Missing username or password for oracledb')

    except oracledb.DatabaseError as exc:
        module.fail_json(msg='Could not connect to database - %s' % (str(exc)), changed=False)

    facts = {}

    # 1. Database and Instance details & current status
    db_inst_query = """
    SELECT
        d.name AS db_name,
        d.db_unique_name,
        d.database_role,
        d.open_mode AS db_open_mode,
        d.log_mode,
        to_char(d.created, 'YYYY-MM-DD HH24:MI:SS') AS db_created,
        d.platform_name,
        d.cdb,
        i.instance_name,
        i.host_name,
        i.version AS instance_version,
        i.status AS instance_status,
        i.database_status,
        i.archiver,
        i.logins,
        to_char(i.startup_time, 'YYYY-MM-DD HH24:MI:SS') AS startup_time,
        i.parallel AS is_rac
    FROM v$database d, v$instance i
    """
    db_inst = safe_query(conn, db_inst_query)
    facts['database_and_instance'] = db_inst[0] if db_inst else {}

    # 2. Oracle Home, Version & Patches (OPatch / SQL Patch registry)
    home_query = "SELECT sys_context('USERENV','ORACLE_HOME') AS oracle_home, sys_context('USERENV','CURRENT_USER') AS current_user, sys_context('USERENV','DB_NAME') AS current_db FROM dual"
    home_info = safe_query(conn, home_query)
    oracle_home = home_info[0].get('oracle_home', '') if home_info else ''

    version_query = "SELECT banner, banner_full, version, version_full FROM v$version WHERE rownum <= 2"
    version_rows = safe_query(conn, version_query)
    db_version = version_rows[0].get('version_full') or version_rows[0].get('version') or conn.version if version_rows else conn.version

    installed_patches = get_opatch_patches(conn)

    facts['oracle_home_and_patches'] = {
        'oracle_home': oracle_home,
        'database_version': db_version,
        'installed_patches': installed_patches
    }

    # 3. Pluggable databases and their statuses
    pdbs_query = """
    SELECT
        con_id,
        name AS pdb_name,
        open_mode,
        restricted,
        to_char(open_time, 'YYYY-MM-DD HH24:MI:SS') AS open_time,
        round(total_size / 1024 / 1024 / 1024, 2) AS total_size_gb
    FROM v$pdbs
    ORDER BY con_id
    """
    facts['pluggable_databases'] = safe_query(conn, pdbs_query)

    # 4. Control file paths
    cf_query = """
    SELECT
        name AS controlfile_path,
        status,
        is_recovery_dest_file,
        block_size,
        round((file_size_blks * block_size) / 1024 / 1024, 2) AS size_mb
    FROM v$controlfile
    ORDER BY name
    """
    facts['control_files'] = safe_query(conn, cf_query)

    # 5. Tablespace names, Datafile paths, and Free space in GB and %
    ts_summary_query = """
    SELECT
        t.tablespace_name,
        t.contents,
        t.status,
        t.bigfile,
        round(sum(df.bytes) / 1024 / 1024 / 1024, 2) AS total_gb,
        round(sum(nvl(f.free_bytes, 0)) / 1024 / 1024 / 1024, 2) AS free_gb,
        round((sum(df.bytes) - sum(nvl(f.free_bytes, 0))) / 1024 / 1024 / 1024, 2) AS used_gb,
        round((sum(nvl(f.free_bytes, 0)) / nullif(sum(df.bytes), 0)) * 100, 2) AS free_pct,
        round(((sum(df.bytes) - sum(nvl(f.free_bytes, 0))) / nullif(sum(df.bytes), 0)) * 100, 2) AS used_pct
    FROM dba_tablespaces t
    JOIN dba_data_files df ON t.tablespace_name = df.tablespace_name
    LEFT JOIN (
        SELECT tablespace_name, file_id, sum(bytes) free_bytes
        FROM dba_free_space
        GROUP BY tablespace_name, file_id
    ) f ON df.file_id = f.file_id
    GROUP BY t.tablespace_name, t.contents, t.status, t.bigfile
    ORDER BY t.tablespace_name
    """
    facts['tablespace_summary'] = safe_query(conn, ts_summary_query)

    df_query = """
    SELECT
        df.tablespace_name,
        df.file_id,
        df.file_name,
        round(df.bytes / 1024 / 1024 / 1024, 2) AS total_gb,
        round(nvl(f.free_bytes, 0) / 1024 / 1024 / 1024, 2) AS free_gb,
        round((df.bytes - nvl(f.free_bytes, 0)) / 1024 / 1024 / 1024, 2) AS used_gb,
        round((nvl(f.free_bytes, 0) / nullif(df.bytes, 0)) * 100, 2) AS free_pct,
        round(((df.bytes - nvl(f.free_bytes, 0)) / nullif(df.bytes, 0)) * 100, 2) AS used_pct,
        df.autoextensible,
        round(df.maxbytes / 1024 / 1024 / 1024, 2) AS maxsize_gb,
        df.status
    FROM dba_data_files df
    LEFT JOIN (
        SELECT file_id, sum(bytes) free_bytes
        FROM dba_free_space
        GROUP BY file_id
    ) f ON df.file_id = f.file_id
    ORDER BY df.tablespace_name, df.file_id
    """
    facts['datafiles'] = safe_query(conn, df_query)

    temp_query = """
    SELECT
        tf.tablespace_name,
        tf.file_id,
        tf.file_name,
        round(tf.bytes / 1024 / 1024 / 1024, 2) AS total_gb,
        tf.autoextensible,
        round(tf.maxbytes / 1024 / 1024 / 1024, 2) AS maxsize_gb,
        tf.status
    FROM dba_temp_files tf
    ORDER BY tf.tablespace_name, tf.file_id
    """
    facts['tempfiles'] = safe_query(conn, temp_query)

    # 6. Redo log information (Online Primary & Standby logs)
    redo_query = """
    SELECT
        l.group#,
        l.thread#,
        l.sequence#,
        round(l.bytes / 1024 / 1024, 2) AS size_mb,
        l.members,
        l.archived,
        l.status AS log_status,
        lf.member AS member_path,
        lf.type AS log_type,
        lf.status AS member_status,
        lf.is_recovery_dest_file
    FROM v$log l
    JOIN v$logfile lf ON l.group# = lf.group#
    ORDER BY l.thread#, l.group#, lf.member
    """
    facts['online_redo_logs'] = safe_query(conn, redo_query)

    stdby_redo_query = """
    SELECT
        sl.group#,
        sl.thread#,
        sl.sequence#,
        round(sl.bytes / 1024 / 1024, 2) AS size_mb,
        sl.archived,
        sl.status AS standby_log_status,
        lf.member AS member_path,
        lf.type AS log_type,
        lf.status AS member_status,
        lf.is_recovery_dest_file
    FROM v$standby_log sl
    JOIN v$logfile lf ON sl.group# = lf.group#
    ORDER BY sl.thread#, sl.group#, lf.member
    """
    facts['standby_redo_logs'] = safe_query(conn, stdby_redo_query)

    # 7. Archive log, Flashback log status and destinations
    arch_dest_query = """
    SELECT
        dest_id,
        dest_name,
        status,
        target,
        destination,
        archiver,
        error
    FROM v$archive_dest
    WHERE destination IS NOT NULL OR status = 'VALID'
    ORDER BY dest_id
    """
    facts['archive_destinations'] = safe_query(conn, arch_dest_query)

    fra_query = """
    SELECT
        name AS recovery_area_name,
        round(space_limit / 1024 / 1024 / 1024, 2) AS space_limit_gb,
        round(space_used / 1024 / 1024 / 1024, 2) AS space_used_gb,
        round(space_reclaimable / 1024 / 1024 / 1024, 2) AS space_reclaimable_gb,
        number_of_files,
        round((space_used / nullif(space_limit, 0)) * 100, 2) AS space_used_pct
    FROM v$recovery_file_dest
    """
    fra_info = safe_query(conn, fra_query)
    facts['flash_recovery_area'] = fra_info[0] if fra_info else {}

    flashback_query = """
    SELECT
        flashback_on,
        log_mode,
        force_logging
    FROM v$database
    """
    fb_info = safe_query(conn, flashback_query)
    facts['flashback_status'] = fb_info[0] if fb_info else {}

    # 8. RMAN Backup Status
    rman_query = """
    SELECT * FROM (
        SELECT
            session_key,
            session_recid,
            command_id,
            input_type,
            status,
            to_char(start_time, 'YYYY-MM-DD HH24:MI:SS') AS start_time,
            to_char(end_time, 'YYYY-MM-DD HH24:MI:SS') AS end_time,
            elapsed_seconds,
            round(input_bytes / 1024 / 1024 / 1024, 2) AS input_gb,
            round(output_bytes / 1024 / 1024 / 1024, 2) AS output_gb,
            output_device_type,
            time_taken_display
        FROM v$rman_backup_job_details
        ORDER BY start_time DESC
    ) WHERE rownum <= 10
    """
    facts['rman_backup_history'] = safe_query(conn, rman_query)

    # 9. Scheduled Jobs
    jobs_query = """
    SELECT
        owner,
        job_name,
        job_type,
        job_action,
        state,
        enabled,
        restartable,
        to_char(last_start_date, 'YYYY-MM-DD HH24:MI:SS') AS last_start_date,
        to_char(next_run_date, 'YYYY-MM-DD HH24:MI:SS') AS next_run_date,
        repeat_interval,
        failure_count,
        run_count
    FROM dba_scheduler_jobs
    WHERE owner NOT IN ('SYS', 'SYSTEM', 'AUDSYS', 'GSMADMIN_INTERNAL')
       OR enabled = 'TRUE'
    ORDER BY owner, job_name
    """
    facts['scheduled_jobs'] = safe_query(conn, jobs_query)

    conn.close()

    module.exit_json(msg="Database facts gathered successfully", changed=False, ansible_facts={'oracle_db_facts': facts})

if __name__ == '__main__':
    main()
