EXAMPLES = '''
- hosts: localhost
  gather_facts: false
  tasks:
  - name: Manage redologs
    oracle_redo:
        hostname: ansible-db
        port: 1521
        service_name: prodcdb
        user: sys
        password: "{{ default_dbpass }}"
        mode: sysdba
        size: 150M
        groups: 3
'''

try:
    import oracledb
except ImportError:
    oracledb_exists = False
else:
    oracledb_exists = True

from ansible.module_utils.basic import AnsibleModule

def main():
    module = AnsibleModule(
        argument_spec = dict(
            hostname      = dict(default='localhost'),
            port          = dict(default=1521, type='int'),
            service_name  = dict(required=True),
            user          = dict(required=False),
            password      = dict(required=False, no_log=True),
            mode          = dict(default='normal', choices=["normal", "sysdba"]),
            size          = dict(required=True),
            groups        = dict(required=True, type='int'),
            datafile      = dict(required=False, aliases=['dest', 'path']),
        ),
    )

    hostname = module.params["hostname"]
    port = module.params["port"]
    service_name = module.params["service_name"]
    user = module.params["user"]
    password = module.params["password"]
    mode = module.params["mode"]
    size = module.params["size"]
    groups = module.params["groups"]
    datafile = module.params["datafile"] or ''

    if not oracledb_exists:
        module.fail_json(msg="The oracledb module is required. 'pip install oracledb' should do the trick. Thin mode is used by default and requires no Oracle client installation.")

    wallet_connect = '/@%s' % service_name
    try:
        if not user and not password:
            if mode == 'sysdba':
                connect = wallet_connect
                conn = oracledb.connect(dsn=wallet_connect, mode=oracledb.SYSDBA)
            else:
                connect = wallet_connect
                conn = oracledb.connect(dsn=wallet_connect)
        elif user and password:
            dsn = oracledb.makedsn(host=hostname, port=port, service_name=service_name)
            connect = dsn
            if mode == 'sysdba':
                conn = oracledb.connect(user=user, password=password, dsn=dsn, mode=oracledb.SYSDBA)
            else:
                conn = oracledb.connect(user=user, password=password, dsn=dsn)
        else:
            module.fail_json(msg='Missing username or password for oracledb')

    except oracledb.DatabaseError as exc:
        module.fail_json(msg='Could not connect to database - %s, connect descriptor: %s' % (str(exc), connect), changed=False)

    size = str(size).strip()
    if not (size.endswith('M') or size.endswith('G') or size.endswith('T') or size.endswith('m') or size.endswith('g') or size.endswith('t')):
        module.fail_json(msg='You need to suffix the size with (M, G or T), i.e: %sM / %sG / %sT' % (size, size, size), changed=False)

    size = size.upper()

    redosql = """
    DECLARE
       -- output
       v_redo_size_changes   number := 0;
       v_redo_group_changes  number := 0;
       -- input
       v_maxbytes            varchar2(20);
       v_groups              number;
       v_dest                varchar2(500);
       -- runtime
       v_maxbytes_actual     number(10,1);
       v_maxbytes_suffix     varchar2(1);
       v_divisor             number(20);
       v_sleep               number := 2;
       v_israc               VARCHAR2(3);
       v_existing_redogroups number;
       v_max_groupnum        number;
       v_group_diff          number;
       v_sql_sw_lf           varchar2(50);
       v_sql_cp              varchar2(50);
       v_add_sql             varchar2(2000);
       v_cur_status          varchar2(30);

       -- exceptions
       missing_suffix exception;

       -- helper function to construct ADD LOGFILE statement for ASM, OMF, or non-OMF filesystem
       FUNCTION get_add_logfile_sql(p_thread NUMBER, p_group NUMBER, p_size VARCHAR2, p_dest VARCHAR2) RETURN VARCHAR2 IS
           v_sql          VARCHAR2(2000);
           v_files        VARCHAR2(2000) := '';
           v_is_omf       NUMBER := 0;
           v_dir          VARCHAR2(500) := '';
           v_sep          VARCHAR2(1) := '/';
           v_member_count NUMBER := 0;
           v_first_member VARCHAR2(500);
       BEGIN
           -- 1. If explicit dest/datafile is provided by user
           IF p_dest IS NOT NULL AND length(trim(p_dest)) > 0 THEN
               IF substr(trim(p_dest), 1, 1) = '+' THEN
                   -- ASM diskgroup (e.g. +DATA)
                   v_sql := 'alter database add logfile thread ' || p_thread || ' group ' || p_group || ' ''' || trim(p_dest) || ''' size ' || p_size;
                   RETURN v_sql;
               ELSE
                   -- Filesystem destination directory
                   v_dir := trim(p_dest);
                   IF instr(v_dir, '/') > 0 THEN
                       v_sep := '/';
                   ELSIF instr(v_dir, '\\') > 0 THEN
                       v_sep := '\\';
                   END IF;
                   IF substr(v_dir, -1) != v_sep THEN
                       v_dir := v_dir || v_sep;
                   END IF;
                   v_files := '''' || v_dir || 'redo' || lpad(to_char(p_group), 2, '0') || '.log''';
                   v_sql := 'alter database add logfile thread ' || p_thread || ' group ' || p_group || ' (' || v_files || ') size ' || p_size;
                   RETURN v_sql;
               END IF;
           END IF;

           -- 2. Check if OMF parameters are configured in the database
           BEGIN
               SELECT count(*) INTO v_is_omf
               FROM v$parameter
               WHERE name IN ('db_create_online_log_dest_1', 'db_create_file_dest')
                 AND value IS NOT NULL;
           EXCEPTION WHEN OTHERS THEN
               v_is_omf := 0;
           END;

           -- 3. Check if existing log members are in ASM (+diskgroup)
           BEGIN
               SELECT member INTO v_first_member
               FROM v$logfile
               WHERE upper(type) = 'ONLINE' AND rownum = 1;
               IF substr(v_first_member, 1, 1) = '+' THEN
                   v_is_omf := 1;
               END IF;
           EXCEPTION WHEN OTHERS THEN
               NULL;
           END;

           -- 4. Return appropriate SQL
           IF v_is_omf > 0 THEN
               -- OMF syntax (ASM or db_create_file_dest)
               v_sql := 'alter database add logfile thread ' || p_thread || ' group ' || p_group || ' size ' || p_size;
               RETURN v_sql;
           ELSE
               -- Non-OMF Filesystem: inspect existing redo log files to determine directory and members
               FOR mrec IN (
                   SELECT member, row_number() over (order by member) as memb_num
                   FROM v$logfile
                   WHERE group# = (SELECT min(group#) FROM v$log WHERE thread# = p_thread)
               ) LOOP
                   v_member_count := v_member_count + 1;
                   IF instr(mrec.member, '/') > 0 THEN
                       v_sep := '/';
                   ELSIF instr(mrec.member, '\\') > 0 THEN
                       v_sep := '\\';
                   END IF;
                   v_dir := substr(mrec.member, 1, instr(mrec.member, v_sep, -1));

                   IF v_files IS NOT NULL AND length(v_files) > 0 THEN
                       v_files := v_files || ', ';
                   END IF;

                   IF v_member_count = 1 THEN
                       v_files := v_files || '''' || v_dir || 'redo' || lpad(to_char(p_group), 2, '0') || '.log''';
                   ELSE
                       v_files := v_files || '''' || v_dir || 'redo' || lpad(to_char(p_group), 2, '0') || '_' || to_char(mrec.memb_num) || '.log''';
                   END IF;
               END LOOP;

               IF v_member_count = 0 THEN
                   v_files := '''redo' || lpad(to_char(p_group), 2, '0') || '.log''';
               END IF;

               v_sql := 'alter database add logfile thread ' || p_thread || ' group ' || p_group || ' (' || v_files || ') size ' || p_size;
               RETURN v_sql;
           END IF;
       END get_add_logfile_sql;

       BEGIN
           v_maxbytes := :redosize;
           v_groups   := :redogroups;
           v_dest     := :dest;

           -- Check if it is a RAC database or not (parallel = True -> RAC)
           SELECT parallel INTO v_israc FROM v$instance;
           IF v_israc = 'YES' THEN
              v_sql_sw_lf := 'alter system switch all logfile';
              v_sql_cp    := 'alter system checkpoint global';
           ELSE
              v_sql_sw_lf := 'alter system switch logfile';
              v_sql_cp    := 'alter system checkpoint';
           END IF;

           -- Get the suffix to decide the divisor
           SELECT substr(v_maxbytes, -1) INTO v_maxbytes_suffix FROM dual;
           IF upper(v_maxbytes_suffix) = 'M' THEN
               v_divisor := 1024*1024;
           ELSIF upper(v_maxbytes_suffix) = 'G' THEN
               v_divisor := 1024*1024*1024;
           ELSIF upper(v_maxbytes_suffix) = 'T' THEN
               v_divisor := 1024*1024*1024*1024;
           ELSE
               RAISE missing_suffix;
           END IF;

           -- Strip the suffix (M/G/T) from the input string
           IF upper(v_maxbytes_suffix) IN ('M','G','T') THEN
               SELECT substr(v_maxbytes, 1, (length(v_maxbytes)-1)) INTO v_maxbytes_actual FROM dual;
           END IF;

           -- Step 1: Resize existing redolog groups if needed
           FOR rec IN (SELECT thread#, group#, status, bytes FROM v$log ORDER BY thread#)
           LOOP
               IF rec.bytes/v_divisor != v_maxbytes_actual THEN
                   v_redo_size_changes := v_redo_size_changes + 1;
                   FOR chloop IN (SELECT thread#, group#, status FROM v$log WHERE thread# = rec.thread# AND group# = rec.group#)
                   LOOP
                       SELECT nvl(max(group#), 0) + 1 INTO v_max_groupnum FROM v$logfile;
                       v_add_sql := get_add_logfile_sql(chloop.thread#, v_max_groupnum, v_maxbytes, v_dest);
                       EXECUTE IMMEDIATE v_add_sql;

                       -- If the group to drop is CURRENT or ACTIVE, switch and checkpoint
                       FOR w IN 1..30 LOOP
                           SELECT status INTO v_cur_status FROM v$log WHERE group# = chloop.group#;
                           EXIT WHEN upper(v_cur_status) NOT IN ('CURRENT', 'ACTIVE');
                           EXECUTE IMMEDIATE v_sql_sw_lf;
                           EXECUTE IMMEDIATE v_sql_cp;
                           dbms_lock.sleep(v_sleep);
                       END LOOP;

                       EXECUTE IMMEDIATE 'alter database drop logfile group ' || chloop.group#;
                   END LOOP;
               END IF;
           END LOOP;

           -- Step 2: Adjust number of redolog groups per thread
           FOR t IN (SELECT * FROM v$thread WHERE enabled != 'DISABLED')
           LOOP
               SELECT count(*) INTO v_existing_redogroups FROM v$log WHERE thread# = t.thread#;
               IF v_existing_redogroups < v_groups THEN
                   v_group_diff := v_groups - v_existing_redogroups;
                   FOR grloop IN 1..v_group_diff
                   LOOP
                       v_redo_group_changes := v_redo_group_changes + 1;
                       SELECT nvl(max(group#), 0) + 1 INTO v_max_groupnum FROM v$logfile;
                       v_add_sql := get_add_logfile_sql(t.thread#, v_max_groupnum, v_maxbytes, v_dest);
                       EXECUTE IMMEDIATE v_add_sql;
                   END LOOP;

               ELSIF v_existing_redogroups > v_groups THEN
                   v_group_diff := v_existing_redogroups - v_groups;
                   FOR grloop IN 1..v_group_diff
                   LOOP
                       v_redo_group_changes := v_redo_group_changes + 1;
                       SELECT max(group#) INTO v_max_groupnum FROM v$log WHERE upper(status) NOT IN ('ACTIVE','CURRENT') AND thread# = t.thread#;
                       IF v_max_groupnum IS NULL THEN
                           EXECUTE IMMEDIATE v_sql_sw_lf;
                           EXECUTE IMMEDIATE v_sql_cp;
                           dbms_lock.sleep(v_sleep);
                           SELECT max(group#) INTO v_max_groupnum FROM v$log WHERE upper(status) NOT IN ('ACTIVE','CURRENT') AND thread# = t.thread#;
                       END IF;
                       IF v_max_groupnum IS NOT NULL THEN
                           EXECUTE IMMEDIATE 'alter database drop logfile group ' || v_max_groupnum;
                       END IF;
                   END LOOP;
               END IF;
           END LOOP;

           :o_size_changed  := v_redo_size_changes;
           :o_group_changed := v_redo_group_changes;
           IF v_redo_size_changes > 0 THEN
               :o_size_msg := 'All redologs have been changed to ' || v_maxbytes;
           ELSE
               :o_size_msg := 'No size changes';
           END IF;

           IF v_redo_group_changes > 0 THEN
               :o_group_msg := 'Groups have been adjusted to ' || v_groups || ' groups';
           ELSE
               :o_group_msg := 'No group changes';
           END IF;

       EXCEPTION
           WHEN missing_suffix THEN
               dbms_output.put_line('You need to suffix the size with (M,G or T), i.e: ' || v_maxbytes || 'M/' || v_maxbytes || 'G/' || v_maxbytes || 'T');
               RAISE;
       END;
    """

    cur = conn.cursor()
    try:
        v_size_changed = cur.var(oracledb.NUMBER)
        v_group_changed = cur.var(oracledb.NUMBER)
        v_size_msg = cur.var(oracledb.STRING)
        v_group_msg = cur.var(oracledb.STRING)
        cur.execute(redosql, {
            'redosize': size,
            'redogroups': groups,
            'dest': datafile,
            'o_size_changed': v_size_changed,
            'o_group_changed': v_group_changed,
            'o_size_msg': v_size_msg,
            'o_group_msg': v_group_msg
        })
    except oracledb.DatabaseError as exc:
        module.fail_json(msg='%s' % (str(exc)), changed=False)

    size_result_changed = v_size_changed.getvalue() or 0
    group_result_changed = v_group_changed.getvalue() or 0
    size_msg = v_size_msg.getvalue() or ''
    group_msg = v_group_msg.getvalue() or ''
    msg = "%s. %s." % (size_msg, group_msg)
    changed = bool(size_result_changed > 0 or group_result_changed > 0)

    module.exit_json(msg=msg, changed=changed)

if __name__ == '__main__':
    main()
